{
  "name": "dsh-plugin-wallpaper-engine",
  "version": "1.3.2",
  "description": "Wallpaper Engine backgrounds for the DSH web GUI: render your local Wallpaper Engine wallpapers behind the chat — Scene and Web in real time through the bundled WebWallGL engine, Video played directly — with iOS-style liquid glass, adjustable blur/scrim/border/opacity, custom typography and caret, and a liquid-glass makeover of the whole settings window. Prerequisite: DeepSeek Harness kernel >= 0.1.5 (0.1.5-rc.1+ — the official desktop line and DSH Desktop >= 2.0.7 both qualify). No version restriction on dsh-better-sidebar.",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elysia395/dsh-wallpaper-engine.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "wallpaper-engine",
    "theme",
    "background"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./about-notice": {
      "default": "./lib/components/about-notice/index.js"
    },
    "./about-notice/package.json": "./lib/components/about-notice/package.json",
    "./about-notice/locale/*.json": "./lib/components/about-notice/locale/*.json",
    "./mascot-avatar": {
      "default": "./lib/components/mascot-avatar/index.js"
    },
    "./mascot-avatar/package.json": "./lib/components/mascot-avatar/package.json",
    "./mascot-avatar/locale/*.json": "./lib/components/mascot-avatar/locale/*.json",
    "./media-bridge": {
      "default": "./lib/components/media-bridge/index.js"
    },
    "./media-bridge/package.json": "./lib/components/media-bridge/package.json",
    "./media-bridge/locale/*.json": "./lib/components/media-bridge/locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.png",
    "lib/index.js",
    "lib/host-boot.js",
    "lib/log.js",
    "lib/notice.js",
    "lib/kernel/",
    "lib/kernel/data-dir.js",
    "lib/kernel/config.js",
    "lib/kernel/host-kernel.js",
    "lib/kernel/host-session.js",
    "lib/routes/",
    "lib/occlusion/",
    "lib/fontsets/",
    "lib/glass-presets/",
    "lib/about/",
    "lib/components/",
    "lib/client.js",
    "lib/http-body.js",
    "lib/json-response.js",
    "lib/pkg-read.js",
    "lib/scene-manifest.js",
    "lib/settings-schema.js",
    "lib/media/",
    "lib/media/transcode.js",
    "lib/media/mp4-probe.js",
    "lib/media/scene-probe.js",
    "lib/media/video-preview.js",
    "lib/media/frame-store.js",
    "lib/media/media-dirs.js",
    "lib/media-origin.js",
    "lib/inventory.js",
    "lib/serve.js",
    "lib/faststart.js",
    "lib/cache-dir.js",
    "lib/upload-store.js",
    "lib/diag-trace.js",
    "lib/http-lifecycle.js",
    "lib/mp4-vfs.js",
    "lib/startup-sweep.js",
    "lib/fs-paths.js",
    "lib/upload-dir.js",
    "lib/wallpaper-scan.js",
    "lib/steam-discovery.js",
    "lib/webwallgl/",
    "lib/we-assets.js",
    "lib/shim-seed.js",
    "lib/we-props.js",
    "lib/we-focus-guard.js",
    "lib/audio-tap.swift",
    "lib/types/index.d.ts",
    "lib/types/client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.beginner.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "verify": "node test/run-guards.mjs verify",
    "verify:docs": "node test/run-guards.mjs docs",
    "verify:bridge": "node test/verify-bridge-ci.mjs --provision",
    "verify:bridge:strict": "node test/verify-media-bridge.mjs --provision",
    "verify:e2e": "node test/e2e-web-media-origin.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:static": "node test/verify-static.mjs",
    "smoke": "node test/run-guards.mjs smoke",
    "verify:all": "node test/run-guards.mjs all",
    "prepack": "node scripts/prepare.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {
    "webwallgl": "^3.0.0",
    "x11": "^4.3.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2"
  }
}
